# Copy to .env for local development. In production, set these in Vercel.

# Resend API key (resend.com/api-keys)
RESEND_API_KEY=

# Where demo requests from /for-programs are emailed (comma-separate for several)
LEAD_NOTIFY_EMAIL=

# Optional sender on a domain verified in Resend, e.g. "Discovery Ladder <leads@yourdomain.com>".
# Leave empty to use Resend's test sender (only delivers to the Resend account owner's email).
LEAD_FROM_EMAIL=
